<?xml version="1.0"?>
<package format="2">
  <name>sonar_image_proc</name>
  <version>0.0.1</version>
  <description>ROS 2 package for manipulating imaging sonar data.</description>

  <maintainer email="ajadhav@marum.de">Ankita Jadhav</maintainer>

  <!-- One license tag required, multiple allowed, one license per tag -->
  <!-- Commonly used license strings: -->
  <!--   BSD, MIT, Boost Software License, GPLv2, GPLv3, LGPLv2.1, LGPLv3 -->
  <license>BSD</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>rclcpp_components</depend>

  <depend>marine_acoustic_msgs</depend>
  <depend>cv_bridge</depend>
  <depend>image_transport</depend>
  <!-- <depend>nodelet_topic_tools</depend> -->
  <depend>std_msgs</depend>

  <build_depend>lifecycle_msgs</build_depend>
  <build_depend>rclcpp_lifecycle</build_depend>

  <exec_depend>rclcpp_lifecycle</exec_depend>
  <exec_depend>lifecycle_msgs</exec_depend>

  <!-- <build_depend>dynamic_reconfigure</build_depend>
  <build_depend>nodelet</build_depend>
  <build_depend>rosbag_storage</build_depend>

  <exec_depend>dynamic_reconfigure</exec_depend>
  <exec_depend>nodelet</exec_depend> -->

  <!-- Testing (optional) -->
  <test_depend>ament_lint_auto</test_depend>
  <test_depend>ament_lint_common</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>

</package>
